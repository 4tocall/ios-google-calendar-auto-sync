# Identifiants OAuth Google (console.cloud.google.com → API et services → Identifiants)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Secrets locaux — génère-les avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ENCRYPTION_KEY=

# Optionnel
PORT=3000
# BASE_URL=http://localhost:3000
# SYNC_EVERY_MINUTES=15   # valeur par défaut, modifiable ensuite dans l’interface
# DB_PATH=sync.sqlite
# TZ=Europe/Paris
